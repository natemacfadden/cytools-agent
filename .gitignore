.ipynb_checkpoints/
__pycache__/
*.egg-info/
# scratch/ stays local; promote DESIGN_LOG-cited evidence files deliberately
# (git add -f scratch/<file>) or move them into diagnostics/
scratch/*
!scratch/.gitkeep
notebooks/scratch/
.DS_Store
.claude/
*.png
*.log
*.jsonl
!eval/*.jsonl
# diagnostics/system_ladder/ is TRACKED: committed eval evidence lives here
# (result JSONs are added deliberately once the corpus matures)
diagnostics/*.md
!diagnostics/README.md

# internal working notes -- kept local, not committed (DESIGN_LOG.md is tracked)
docs/ROADMAP.md
